<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets tools/release/publish.sh post an update APK to Saved Messages via adb. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.yiligram.update.PublishReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.yiligram.update.PUBLISH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
