# Copy to keystore.properties (git-ignored) to sign release builds.
# Create a key once with:
#   keytool -genkeypair -v -keystore yiligram-release.jks -alias yiligram \
#           -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks file and passwords outside of git, and back them up: losing the
# key means users cannot update to new releases.
# Alternatively export YILI_KEYSTORE_FILE / YILI_KEYSTORE_PASSWORD /
# YILI_KEY_ALIAS / YILI_KEY_PASSWORD.
storeFile=../yiligram-release.jks
storePassword=change-me
keyAlias=yiligram
keyPassword=change-me
